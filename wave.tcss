/* Wave-CLI Stylesheet - 100% True Transparent (Zero-Tint) */

Screen, App, Container, Horizontal, Vertical {
    background: transparent;
    color: #cdd6f4;
}

#top-bar {
    dock: top;
    height: 1;
    background: transparent;
    color: #89b4fa;
    padding: 0 1;
    layout: horizontal;
    border-bottom: solid #313244;
}

#top-title {
    width: 1fr;
    text-style: bold;
    color: #89dceb;
}

#top-right {
    width: auto;
    color: #6c7086;
}

#body-container {
    height: 1fr;
    layout: horizontal;
    background: transparent;
}

#sidebar {
    width: 27;
    height: 100%;
    background: transparent;
    border-right: solid #313244;
    padding: 0 1;
    overflow-y: auto;
}

.sidebar-heading {
    color: #f38ba8;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
    padding: 0;
    text-align: left;
    width: 100%;
}

.sidebar-divider {
    color: #313244;
    margin-bottom: 1;
    padding: 0;
    text-align: left;
    width: 100%;
}

/* Interactive Button Styles with Smooth Hover Effects */
Button {
    background: transparent;
    border: none;
    min-width: 4;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    color: #89b4fa;
}

Button:hover {
    background: #89b4fa 30%;
    color: #ffffff;
    text-style: bold;
}

Button:focus {
    background: #89b4fa 20%;
    border: none;
}

.nav-button {
    width: 100%;
    text-align: left;
    color: #a6adc8;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    height: 1;
}

.nav-button:hover {
    background: #89b4fa 25%;
    color: #89dceb;
    text-style: bold;
}

.nav-active {
    background: #89b4fa 20%;
    color: #89dceb;
    text-style: bold;
}

.shortcuts-title {
    color: #f9e2af;
    text-style: bold;
    margin-top: 1;
    padding: 0;
    text-align: left;
    width: 100%;
}

.shortcut-text {
    color: #6c7086;
    padding: 0;
    text-align: left;
    width: 100%;
}

#main-content {
    width: 1fr;
    height: 100%;
    padding: 0 1;
    layout: vertical;
    background: transparent;
}

#view-header {
    width: 100%;
    height: 1;
    margin-top: 1;
    margin-bottom: 0;
}

#view-title {
    width: 1fr;
    height: 1;
    color: #89b4fa;
    text-style: bold;
    margin-top: 0;
    margin-bottom: 0;
}

#view-actions {
    width: auto;
    height: 1;
}

.view-action-btn {
    width: auto;
    min-width: 0;
    height: 1;
    background: transparent;
    border: none;
    color: #89b4fa;
    padding: 0 1;
    margin-left: 1;
}

.view-action-btn:hover {
    background: #89b4fa 30%;
    color: #ffffff;
    text-style: bold;
}

/* Input Box - 100% Transparent Without Built-in Surface Tint */
Input {
    height: 3;
    border: solid #45475a;
    background: transparent;
    background-tint: transparent;
    color: #cdd6f4;
    margin-top: 0;
    margin-bottom: 1;
}

Input:focus {
    border: solid #89b4fa;
    background: transparent;
    background-tint: transparent;
}

#search-status {
    height: 1;
    color: #fab387;
    margin-bottom: 0;
}

/* Spotify-Style Interactive Track List & 2-Line Rows (100% Transparent) */

#tracks-scroll {
    width: 100%;
    height: 1fr;
    background: transparent;
    border: solid #313244;
    padding: 0;
    scrollbar-background: transparent;
    scrollbar-color: #45475a;
    scrollbar-color-hover: #89b4fa;
    scrollbar-color-active: #b4befe;
}

#tracks-scroll:focus {
    border: solid #585b70;
}

TrackRow {
    height: 1;
    background: transparent;
    padding: 0 1;
    border: none;
}

TrackRow:hover {
    background: #89b4fa 15%;
}

TrackRow.row-selected {
    background: #89b4fa 22%;
    border-left: heavy #89b4fa;
}

TrackRow.row-playing {
    background: #a6e3a1 15%;
    border-left: heavy #a6e3a1;
}

TrackRow.row-playing .row-title {
    color: #a6e3a1;
    text-style: bold;
}

TrackRow.row-playing .row-num {
    color: #a6e3a1;
    text-style: bold;
}

TrackRow.row-playing .row-play-btn {
    color: #a6e3a1;
}

TrackRow.row-radio {
    color: #94e2d5;
}

TrackRow.row-radio .row-num {
    color: #f9e2af;
}

TrackRow.row-radio .row-title {
    color: #94e2d5;
}

#btn-toggle-autoplay {
    color: #a6e3a1;
}

#btn-toggle-autoplay:hover {
    background: #a6e3a1 30%;
    color: #ffffff;
}

.row-num {
    width: 3;
    height: 1;
    color: #6c7086;
    padding-top: 0;
    margin-right: 1;
}

.row-play-btn {
    width: 8;
    height: 1;
    min-width: 8;
    background: transparent;
    border: none;
    color: #89b4fa;
    padding: 0;
    margin-right: 1;
}

.row-play-btn:hover {
    background: #89b4fa 35%;
    color: #ffffff;
    text-style: bold;
}

.row-title {
    width: 1fr;
    height: 1;
    color: #cdd6f4;
    overflow-x: hidden;
    text-overflow: ellipsis;
    margin-right: 1;
}

.row-action-btn {
    width: auto;
    height: 1;
    min-width: 0;
    background: transparent;
    border: none;
    color: #89b4fa;
    padding: 0 1;
    margin-right: 1;
}

.row-action-btn:hover {
    background: #89b4fa 30%;
    color: #ffffff;
    text-style: bold;
}

.row-fav-btn.is-liked {
    color: #f38ba8;
}

.row-fav-btn.is-liked:hover {
    background: #f38ba8 30%;
    color: #ffffff;
}

.row-duration {
    color: #a6adc8;
    padding: 0 1;
    width: 7;
    text-align: right;
}

.empty-state {
    color: #6c7086;
    padding: 2 3;
}

#player-bar {
    dock: bottom;
    height: 6;
    background: transparent;
    border-top: solid #45475a;
    padding: 0 1;
    layout: vertical;
}

#player-controls {
    height: 1;
    layout: horizontal;
    background: transparent;
    margin-top: 0;
    margin-bottom: 0;
}

.player-btn {
    height: 1;
    min-width: 0;
    width: auto;
    background: transparent;
    border: none;
    color: #89b4fa;
    padding: 0 1;
    margin-right: 1;
}

#btn-play {
    min-width: 0;
    width: 10;
}

.player-btn:hover {
    background: #89b4fa 30%;
    color: #ffffff;
    text-style: bold;
}

#player-title {
    height: 1;
    color: #cdd6f4;
    text-style: bold;
}

#player-progress {
    height: 1;
    color: #a6e3a1;
}

#player-status {
    height: 1;
    color: #6c7086;
}

/* Playlist and Modal Styles (100% Transparent Glass) */

.pl-add-button {
    color: #a6e3a1;
    text-align: left;
    height: 1;
    padding: 0;
    margin: 0;
    width: 100%;
}

.pl-add-button:hover {
    background: #a6e3a1 25%;
    color: #ffffff;
    text-style: bold;
}

#sidebar-playlists {
    height: auto;
    max-height: 8;
    overflow-y: auto;
    background: transparent;
    margin-bottom: 1;
}

NewPlaylistModal, PlaylistSelectModal {
    align: center middle;
    background: transparent;
}

#modal-dialog {
    width: 48;
    height: auto;
    border: heavy #89b4fa;
    background: transparent;
    padding: 1 2;
}

#modal-dialog-select {
    width: 52;
    height: auto;
    max-height: 22;
    border: heavy #89b4fa;
    background: transparent;
    padding: 1 2;
}

.modal-header {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

.modal-header #modal-title {
    width: 1fr;
    margin-bottom: 0;
}

.modal-close-btn {
    width: 8;
    height: 1;
    min-width: 0;
    background: transparent;
    border: none;
    color: #f38ba8;
    padding: 0;
}

.modal-close-btn:hover {
    background: #f38ba8 30%;
    color: #ffffff;
    text-style: bold;
}

#modal-title {
    color: #89dceb;
    text-style: bold;
    margin-bottom: 1;
}

#modal-subtitle {
    color: #a6adc8;
    margin-bottom: 1;
}

#new-pl-input, #rename-pl-input {
    border: solid #89b4fa;
    background: transparent;
    color: #cdd6f4;
    margin-bottom: 1;
}

#modal-confirm-msg {
    color: #cdd6f4;
    margin-bottom: 1;
}

#modal-btn-row {
    height: 1;
    margin-top: 1;
}

.modal-btn {
    height: 1;
    min-width: 10;
    background: transparent;
    border: none;
    color: #89b4fa;
    margin-right: 2;
}

.modal-btn:hover {
    background: #89b4fa 30%;
    color: #ffffff;
    text-style: bold;
}

.modal-btn-danger {
    color: #f38ba8;
}

.modal-btn-danger:hover {
    background: #f38ba8 30%;
    color: #ffffff;
    text-style: bold;
}

.pl-select-btn {
    width: 100%;
    text-align: left;
    height: 1;
    background: transparent;
    border: none;
    color: #cdd6f4;
    padding: 0 1;
    margin-bottom: 0;
}

.pl-select-btn:hover {
    background: #89b4fa 25%;
    color: #89dceb;
    text-style: bold;
}

.pl-create-btn {
    color: #a6e3a1;
    margin-bottom: 1;
}

.pl-create-btn:hover {
    background: #a6e3a1 25%;
    color: #ffffff;
    text-style: bold;
}

#pl-scroll-list {
    height: auto;
    max-height: 10;
    background: transparent;
    margin-bottom: 1;
}
